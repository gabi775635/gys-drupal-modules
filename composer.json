{
  "name": "gys/drupal-modules",
  "description": "Modules Drupal GYS - Gestion Documentaire",
  "type": "project",
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "symfony/http-foundation": "^6.4"
  },
  "autoload": {
    "psr-4": {
      "Drupal\\gestion_documentaire\\": "modules/gestion_documentaire/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Drupal\\Tests\\gestion_documentaire\\": "modules/gestion_documentaire/tests/src/"
    },
    "files": [
      "tests/stubs/drupal_stubs.php"
    ]
  },
  "config": {
    "allow-plugins": true
  }
}
