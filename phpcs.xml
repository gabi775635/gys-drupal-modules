<?xml version="1.0"?>
<ruleset name="GYS Drupal Modules">
  <description>PHP_CodeSniffer standards pour les modules Drupal GYS</description>

  <!-- Répertoires à analyser -->
  <file>modules/gestion_documentaire/src</file>
  <file>modules/entity_revision</file>

  <!-- Fichiers exclus -->
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*.min.js</exclude-pattern>
  <exclude-pattern>*.min.css</exclude-pattern>

  <!-- Extensions analysées -->
  <arg name="extensions" value="php,module,inc,install,test,profile,theme,info,yml"/>

  <!-- Format de rapport -->
  <arg name="report" value="full"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <!-- Standards Drupal -->
  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>

  <!-- Règles spécifiques GYS -->
  <!-- Autorise les commentaires français -->
  <rule ref="Drupal.Commenting.DocComment">
    <properties>
      <property name="allowedLanguages" value="fr,en"/>
    </properties>
  </rule>

  <!-- Longueur de ligne : 120 caractères max (Drupal standard = 80, assoupli) -->
  <rule ref="Generic.Files.LineLength">
    <properties>
      <property name="lineLimit" value="120"/>
      <property name="absoluteLineLimit" value="150"/>
    </properties>
  </rule>

</ruleset>
